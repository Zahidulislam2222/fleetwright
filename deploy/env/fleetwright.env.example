# Fleetwright backend on the shared VPS (deploy/templates/compose.yaml). Hostnames are Compose
# service names on the internal backend network; nothing here is reachable from outside.
FW_ENVIRONMENT=vps
FW_CONFIG_DIR=/app/config
FW_LOG_LEVEL=INFO
FW_APP_DB__DSN=postgresql+asyncpg://fw_app:__FW_PG_APP_PASSWORD__@postgres:5432/fleetwright
FW_WORKER_DB__DSN=postgresql+asyncpg://fw_worker:__FW_PG_WORKER_PASSWORD__@postgres:5432/fleetwright
FW_OWNER_DB__DSN=postgresql+asyncpg://fw_owner:__FW_PG_OWNER_PASSWORD__@postgres:5432/fleetwright
FW_BOARD_DB__DSN=postgresql+asyncpg://fw_board:__FW_PG_BOARD_PASSWORD__@postgres:5432/mockboard
FW_APP_DB__POOL_SIZE=5
FW_WORKER_DB__POOL_SIZE=5
FW_REDIS__CORE_URL=redis://redis-core:6379/0
FW_REDIS__CELLS={"cell-a": "redis://redis-cell-a:6379/0"}
# The mock board is internal only; public_url is not used by any code path yet.
FW_BOARD_CLIENT__INTERNAL_URL=http://board:8100
FW_BOARD_CLIENT__PUBLIC_URL=http://board:8100
FW_BOARD_CLIENT__ADMIN_TOKEN=__FW_BOARD_ADMIN_TOKEN__
FW_BOARD__ADMIN_TOKEN=__FW_BOARD_ADMIN_TOKEN__
FW_BOARD__COOKIE_SECURE=false
FW_BOARD__EMAIL_DOMAIN=board.demo.test
FW_BOARD__SMTP_HOST=mailpit
FW_BOARD__SMTP_PORT=1025
FW_BOARD__MAIL_FROM=no-reply@board.demo.test
FW_BOARD__SESSION_TTL_S=1800
FW_BOARD__FEED_RATE_PER_MIN=6
FW_MAILPIT__API_URL=http://mailpit:8025
FW_VAULT__MASTER_KEY_B64=__FW_VAULT_MASTER_KEY_B64__
FW_VAULT__KEY_ID=vps-1
FW_WORKER__CELL=cell-a
FW_CONTROL__CELL=cell-a
FW_WORKER__RESERVED_ACCOUNT_GROUPS=["workflow"]
FW_WORKER__CONTEXTS=4
FW_WORKER__WATCHERS=1
FW_WORKER__DETECTION_BATCH=100
FW_WORKER__HEADLESS=true
FW_WORKER__ACTION_MODE=http
FW_STORAGE__LOCAL_DIR=/data/evidence
FW_STORAGE__RETENTION_DAYS=7
FW_AUTH__COOKIE_SECURE=true
FW_DEMO__PUBLIC_READ=true
FW_DEMO__SHOW_DEMO_MFA_CODE=true
FW_DEMO__ACCOUNT_EMAIL=demo@fleetwright.demo
FW_DEMO__ACCOUNT_PASSWORD=__FW_DEMO_PASSWORD__
FW_SEED__CELL=cell-a
FW_SEED__OWNER_EMAIL=owner@fleetwright.demo
FW_SEED__OWNER_PASSWORD=__FW_OWNER_PASSWORD__
FW_SEED__OWNER_TOTP_B32=__FW_OWNER_TOTP_B32__
# Inside the container; only nginx on the internal network reaches these ports.
FW_CLAIMS__DETECTION_RETRY_S=5
FW_API__HOST=0.0.0.0
FW_API__PORT=8200
FW_API__TRUSTED_PROXY_HOPS=1
FW_GATEWAY__HOST=0.0.0.0
FW_GATEWAY__PORT=8300

# Reliable workflow execution and local MCP (MCP grant is issued by the human owner API)
FW_WORKFLOWS__LEASE_S=90
FW_WORKFLOWS__APPROVAL_TTL_S=300
FW_WORKFLOWS__GRANT_TTL_S=3600
FW_WORKFLOWS__POLL_S=1
FW_WORKFLOWS__EVIDENCE_PAGE_SIZE=100
FW_WORKFLOWS__ACTION_TIMEOUT_MS=10000
FW_WORKFLOWS__RECONCILE_GRACE_S=10
FW_WORKFLOWS__ALERT_UNKNOWN_AFTER_S=300
FW_WORKFLOWS__RESPONSE_MAX_BYTES=65536
FW_WORKFLOWS__LEASE_MARGIN_S=5
FW_WORKFLOWS__TENANT_BATCH=32
FW_WORKFLOWS__JOBS_PER_TENANT=1
FW_WORKFLOWS__DRAIN_TIMEOUT_S=20
FW_GATEWAY__REVOCATION_CHECK_S=1
FW_MCP__TENANT_ID=__AUTHORIZED_TENANT_UUID__
FW_MCP__ACCESS_TOKEN=__GENERATED_MCP_ACCESS_TOKEN__

# Host-side verified private backups; supervise using the generated backup service
FW_BACKUP__DIRECTORY=var/backups
FW_BACKUP__CONTAINER=fleetwright-postgres-1
FW_BACKUP__EXECUTABLE=docker
FW_BACKUP__USERNAME=postgres
FW_BACKUP__DATABASES=["fleetwright","mockboard"]
FW_BACKUP__TIMEOUT_S=120
FW_BACKUP__INTERVAL_S=86400
FW_BACKUP__RETENTION_COUNT=7

# Free local/server monitoring. Independent public probes must run off the server.
FW_MONITOR__DATABASE=var/monitor/monitor.sqlite
FW_MONITOR__PROBES=[{"name":"public_health","url":"https://fleetwright.zahidul-islam.com/healthz"}]
FW_MONITOR__INTERVAL_S=60
FW_MONITOR__TIMEOUT_S=10
FW_MONITOR__FAILURES_BEFORE_ALERT=3
FW_MONITOR__RESPONSE_MAX_BYTES=65536
FW_MONITOR__RETENTION_DAYS=30
FW_MONITOR__BACKUP_MAX_AGE_S=172800
# FW_MONITOR__BACKUP_DIRECTORY=var/backups
FW_MONITOR__NOTIFICATION_FILE=var/monitor/notifications.json
FW_MONITOR__NOTIFICATION_LIMIT=200
# Server renewal is opt-in; installer supplies these only in its protected service environment:
# FW_MONITOR_GRANT__TENANT_ID=__MONITOR_TENANT_UUID__
# FW_MONITOR_GRANT__USER_ID=__MONITOR_OWNER_UUID__
# FW_MONITOR_GRANT__TOKEN_FILE=var/monitor/observation-grant.json
# FW_MONITOR_GRANT__TTL_S=3600
# FW_MONITOR_GRANT__RENEWAL_MARGIN_S=300
# FW_MONITOR_GRANT__AUTHORITY_COMMAND=["docker","exec","-i","fleetwright-api-1","python","-m","fw_coordinator.monitor_grant"]

# Independent recovery encryption key; do not reuse the session vault key.
FW_RECOVERY__DIRECTORY=var/offhost
FW_RECOVERY__MASTER_KEY_B64=__FW_RECOVERY_MASTER_KEY_B64__
FW_RECOVERY__KEY_ID=offhost-1
FW_RECOVERY__MAX_ARCHIVE_BYTES=268435456
FW_RECOVERY__RETENTION_COUNT=7
FW_RELEASE_SIGNING__PRIVATE_KEY_FILE=memory/release-signing/owner.pem
FW_RELEASE_SIGNING__PUBLIC_KEY_FILE=config/release-signing-public.pem
FW_RELEASE_SIGNING__KEY_ID=owner-local-1

FW_CRAWL__OUTPUT_DIRECTORY=var/crawls
FW_CRAWL__CELL=cell-a
FW_CRAWL__TIMEOUT_S=5
FW_CRAWL__REQUEST_BUDGET_S=10
FW_CRAWL__LEASE_S=60
FW_CRAWL__POLL_S=2
FW_CRAWL__DOMAIN_DELAY_S=1
FW_CRAWL__MAX_PAGES=100
FW_CRAWL__MAX_ITEMS_PER_PAGE=1000
FW_CRAWL__MAX_RESPONSE_BYTES=2097152
FW_CRAWL__MAX_ATTEMPTS=3
FW_CRAWL__RETRY_BASE_S=2
FW_CRAWL__RETRY_JITTER_S=1
FW_CRAWL__TENANT_BATCH=100
FW_CRAWL__RETENTION_BATCH=100
FW_CRAWL__RETENTION_DAYS=7
FW_CRAWL__DROP_ALERT_SHARE=0.5
FW_CRAWL__USER_AGENT=FleetwrightCrawler
# Explicit exception for the configured, owned board only; external origins remain forbidden.
FW_CRAWL__OWNED_ORIGIN_PRIVATE_ACCESS=true
FW_CRAWL__ORIGINS={}

# Standalone local agent. Model inference is local; no paid API is configured.
FW_AGENT__DATABASE=var/agent/agent.sqlite
FW_AGENT__PROFILE_DIRECTORY=var/agent/browser
FW_AGENT__EVIDENCE_DIRECTORY=var/agent/evidence
FW_AGENT__MODEL_URL=http://127.0.0.1:11434
FW_AGENT__MODEL_ID=qwen3:1.7b
FW_AGENT__HOST=127.0.0.1
FW_AGENT__PORT=8400
FW_AGENT__ALLOWED_ORIGINS=["http://127.0.0.1:8400"]
FW_AGENT__HEADLESS=true
FW_AGENT__MODEL_TIMEOUT_S=120
FW_AGENT__MODEL_MAX_BYTES=65536
FW_AGENT__MODEL_MAX_TOKENS=512
FW_AGENT__MODEL_KEEP_ALIVE_S=0
FW_AGENT__TASK_TIMEOUT_S=180
FW_AGENT__ACTION_TIMEOUT_MS=10000
FW_AGENT__MAX_TABS=3
FW_AGENT__MAX_ACTIONS=12
FW_AGENT__APPROVAL_TTL_S=300
FW_AGENT__MAX_CONTENT_CHARS=2000
FW_AGENT__MAX_REQUEST_BYTES=16384
FW_AGENT__MAX_REQUESTS=100
FW_AGENT__HISTORY_LIMIT=100
FW_AGENT__LAB_ENABLED=true
