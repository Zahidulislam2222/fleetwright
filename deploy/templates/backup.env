# Private host environment: install root-owned mode 0600. No database passwords are required.
FW_ENVIRONMENT=vps
FW_CONFIG_DIR={{releaseRoot}}/../build/{{releaseId}}/config
FW_BACKUP__DIRECTORY={{backupDirectory}}
FW_BACKUP__CONTAINER={{slug}}-postgres-1
FW_BACKUP__EXECUTABLE={{backupDockerExecutable}}
FW_BACKUP__USERNAME={{backupUsername}}
FW_BACKUP__DATABASES={{backupDatabases}}
