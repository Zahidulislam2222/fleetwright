# GENERATED from deploy/templates/site.caddy by deploy/build-release.mjs — edit the template.
# Caddy appends the connecting peer to X-Forwarded-For; nginx uses that last entry to decide whether
# CF-Connecting-IP can be believed. trusted_proxies (this site only; the shared main Caddyfile is
# untouched) just lets Caddy's own log show the visitor. Server-sent events are flushed as they arrive.
{{hostname}} {
    reverse_proxy 127.0.0.1:{{loopbackPort}} {
        trusted_proxies {{cloudflareRanges}}
        flush_interval -1
    }
    log
}
