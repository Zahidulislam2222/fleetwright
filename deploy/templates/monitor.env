# Private mode0600 runtime environment. Installer replaces identity placeholders from seeded owner.
# The initial fake bearer is replaced in memory by a short-lived, renewable observe-only grant.
FW_ENVIRONMENT=vps
FW_CONFIG_DIR={{buildDirectory}}/config
FW_MONITOR__DATABASE={{monitorDirectory}}/monitor.sqlite
FW_MONITOR__NOTIFICATION_FILE={{monitorDirectory}}/notifications.json
FW_MONITOR__PROBES='[{"name":"origin_health","url":"http://127.0.0.1:{{loopbackPort}}{{healthPath}}"},{"name":"workflow_metrics","url":"http://127.0.0.1:{{loopbackPort}}/v1/workflows/metrics","bearer_token":"test-key-runtime-renewal"}]'
FW_MONITOR__INTERVAL_S={{monitorIntervalS}}
FW_MONITOR__TIMEOUT_S={{monitorTimeoutS}}
FW_MONITOR__FAILURES_BEFORE_ALERT={{monitorFailuresBeforeAlert}}
FW_MONITOR__RETENTION_DAYS={{monitorRetentionDays}}
FW_MONITOR__RESPONSE_MAX_BYTES={{monitorResponseMaxBytes}}
FW_MONITOR__NOTIFICATION_LIMIT={{monitorNotificationLimit}}
FW_MONITOR__BACKUP_DIRECTORY={{backupDirectory}}
FW_MONITOR__BACKUP_MAX_AGE_S={{monitorBackupMaxAgeS}}
FW_MONITOR_GRANT__TENANT_ID=__FW_MONITOR_TENANT_ID__
FW_MONITOR_GRANT__USER_ID=__FW_MONITOR_USER_ID__
FW_MONITOR_GRANT__TOKEN_FILE={{monitorDirectory}}/observation-grant.json
FW_MONITOR_GRANT__AUTHORITY_COMMAND='["{{backupDockerExecutable}}","exec","-i","{{slug}}-api-1","python","-m","fw_coordinator.monitor_grant"]'
