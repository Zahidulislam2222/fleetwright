# Fleetwright environment variables.
# Names and safe local examples only — never real values. Real values live in CREDENTIALS.md (gitignored).
# Every FW_* variable is read through packages/fw_core/src/fw_core/settings.py (a test checks this file
# against it). Create a working local .env with:  uv run python tools/dev/make_env.py
# Values written as __NAME__ are random secrets that make_env.py generates; it never prints them.

# ─── Design media generator (tools/media/generate.py; settings in tools/media/config.json) ───
OPENROUTER_KEY_FILE=/path/to/openrouter.key

# ─── Dashboard release build (set by deploy/build-release.mjs; leave unset for `next dev`) ───
FLEETWRIGHT_STATIC_EXPORT=

# ─── Local Compose stack (infra/compose/local.yaml): host ports, all bound to 127.0.0.1 ───
FWDEV_PG_PORT=55432
FWDEV_REDIS_CORE_PORT=56379
FWDEV_REDIS_CELL_A_PORT=56380
FWDEV_REDIS_CELL_B_PORT=56381
FWDEV_SMTP_PORT=51025
FWDEV_MAILPIT_PORT=58025
FWDEV_PG_SUPERUSER_PASSWORD=__FW_PG_SUPERUSER_PASSWORD__
FWDEV_PG_OWNER_PASSWORD=__FW_PG_OWNER_PASSWORD__
FWDEV_PG_APP_PASSWORD=__FW_PG_APP_PASSWORD__
FWDEV_PG_WORKER_PASSWORD=__FW_PG_WORKER_PASSWORD__
FWDEV_PG_BOARD_PASSWORD=__FW_PG_BOARD_PASSWORD__

# ─── Services ───
FW_ENVIRONMENT=local
FW_CONFIG_DIR=config
FW_LOG_LEVEL=INFO

FW_APP_DB__DSN=postgresql+asyncpg://fw_app:__FW_PG_APP_PASSWORD__@127.0.0.1:55432/fleetwright
FW_WORKER_DB__DSN=postgresql+asyncpg://fw_worker:__FW_PG_WORKER_PASSWORD__@127.0.0.1:55432/fleetwright
FW_OWNER_DB__DSN=postgresql+asyncpg://fw_owner:__FW_PG_OWNER_PASSWORD__@127.0.0.1:55432/fleetwright
FW_BOARD_DB__DSN=postgresql+asyncpg://fw_board:__FW_PG_BOARD_PASSWORD__@127.0.0.1:55432/mockboard
FW_APP_DB__POOL_SIZE=10
FW_WORKER_DB__POOL_SIZE=10

FW_REDIS__CORE_URL=redis://127.0.0.1:56379/0
FW_REDIS__CELLS={"cell-a": "redis://127.0.0.1:56380/0", "cell-b": "redis://127.0.0.1:56381/0"}

FW_BOARD_CLIENT__INTERNAL_URL=http://127.0.0.1:8100
FW_BOARD_CLIENT__PUBLIC_URL=http://127.0.0.1:8100
FW_BOARD_CLIENT__ADMIN_TOKEN=__FW_BOARD_ADMIN_TOKEN__
FW_BOARD__ADMIN_TOKEN=__FW_BOARD_ADMIN_TOKEN__
FW_BOARD__COOKIE_SECURE=false
FW_BOARD__EMAIL_DOMAIN=board.demo.test
FW_BOARD__SMTP_HOST=127.0.0.1
FW_BOARD__SMTP_PORT=51025
FW_BOARD__MAIL_FROM=no-reply@board.demo.test
FW_BOARD__SESSION_TTL_S=1800
FW_BOARD__FEED_RATE_PER_MIN=6

FW_MAILPIT__API_URL=http://127.0.0.1:58025

FW_VAULT__MASTER_KEY_B64=__FW_VAULT_MASTER_KEY_B64__
FW_VAULT__KEY_ID=local-1

FW_WORKER__CELL=cell-a
# Control loops (dispatcher, outbox relay, reconciler) for one cell
FW_CONTROL__CELL=cell-a
FW_WORKER__CONTEXTS=4
FW_WORKER__WATCHERS=1
FW_WORKER__HEADLESS=true
FW_WORKER__ACTION_MODE=http

FW_STORAGE__LOCAL_DIR=var/evidence
FW_STORAGE__RETENTION_DAYS=7

FW_AUTH__COOKIE_SECURE=false
FW_DEMO__PUBLIC_READ=true
FW_DEMO__SHOW_DEMO_MFA_CODE=true
# The shared demo login (its password is shown publicly on the login page by design)
FW_DEMO__ACCOUNT_EMAIL=demo@fleetwright.demo
FW_DEMO__ACCOUNT_PASSWORD=__FW_DEMO_PASSWORD__
# Seed (python -m fw_coordinator.seed): demo tenant owner. The TOTP secret is base32.
FW_SEED__CELL=cell-a
FW_SEED__OWNER_EMAIL=owner@fleetwright.demo
FW_SEED__OWNER_PASSWORD=__FW_OWNER_PASSWORD__
FW_SEED__OWNER_TOTP_B32=__FW_OWNER_TOTP_B32__

# Coordinator API + gateway bind addresses for local runs (read by tools/dev/run_local.py).
FWDEV_API_PORT=8200
FWDEV_GATEWAY_PORT=8300
FWDEV_BOARD_PORT=8100
