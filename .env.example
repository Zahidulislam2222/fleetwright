# Fleetwright environment variables.
# Names and safe placeholders only — never real values. Real values live in CREDENTIALS.md (gitignored).
# Every variable here must also be read through the central typed config module.

# Design media generator (tools/media/generate.py; settings in tools/media/config.json).
# Path to a local file holding the OpenRouter API key — the key itself never goes in env or git.
OPENROUTER_KEY_FILE=/path/to/openrouter.key

# Dashboard release build (set by deploy/build-release.mjs; leave unset for `next dev`).
# 1 = static export to apps/dashboard/out for nginx; security headers then come from nginx.
FLEETWRIGHT_STATIC_EXPORT=
